{
  "name": "@jaingxyz/personal-outlook-mcp",
  "version": "0.1.3",
  "description": "Model Context Protocol server for a personal Outlook (consumer Microsoft account) inbox and calendar, via Microsoft Graph. Stdio transport, MSAL device-code auth, OS-keyring token cache.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "jaingxyz",
  "homepage": "https://github.com/jaingxyz/personal-outlook-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaingxyz/personal-outlook-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jaingxyz/personal-outlook-mcp/security/advisories/new"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "outlook",
    "microsoft-graph",
    "msal",
    "claude",
    "anthropic"
  ],
  "bin": {
    "personal-outlook-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "whoami": "node dist/scripts/whoami.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stats": "node scripts/stats.mjs",
    "stats:history": "node scripts/stats.mjs --history",
    "bundle": "npm run build && rm -rf bundle personal-outlook-mcp.mcpb && mkdir -p bundle/server && cp -r dist/* bundle/server/ && cp scripts/bundle/server-package.json bundle/server/package.json && cp assets/icon.png bundle/icon.png && node scripts/bundle/build-manifest.mjs && (cd bundle/server && npm install --omit=dev --no-fund --no-audit) && npx --yes @anthropic-ai/mcpb pack bundle personal-outlook-mcp.mcpb && node scripts/bundle/swap-manifest.mjs",
    "prepare": "node -e \"if (process.env.CI || !require('fs').existsSync('.git')) process.exit(0)\" && husky",
    "prepublishOnly": "npm run build && npm run lint && npm run format:check && npm test",
    "clean": "rm -rf dist coverage"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": "prettier --write",
    "*.ts": "eslint --fix"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "isomorphic-fetch": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  }
}
